{
  "expo": {
    "name": "NutriFybe",
    "slug": "nutrifybe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-1024.png",
    "scheme": "nutrifybe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00BCD4",
        "foregroundImage": "./assets/images/app-icon-1024.png",
        "monochromeImage": "./assets/images/icone-roxo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4FEFF",
          "dark": {
            "image": "./assets/images/app-icon-1024-escuro.png",
            "backgroundColor": "#13111A"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
